{
  "id": "agents.hashline_edit",
  "phase": "agents",
  "pillar": "crates/codegen/xai-grok-tools",
  "needs_model": true,
  "max_turns": 8,
  "timeout_secs": 900,
  "permission": "approve",
  "allow": [
    "Edit(*)"
  ],
  "deny": [],
  "extra_args": [
    "--tools",
    "hashline_edit"
  ],
  "prompt": "prompts/agents.hashline_edit.txt",
  "expect_tools": [
    "hashline_edit"
  ],
  "forbid_tools": [],
  "files": [
    {
      "path": "note.txt",
      "equals": "first\nDONE-EDIT\nlast\n"
    }
  ],
  "checks": [
    "no_session",
    "tool_called",
    "file_equals",
    "usage_honest",
    "loop_realtime"
  ]
}
