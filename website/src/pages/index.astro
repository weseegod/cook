            <li>
              <a data-asset="linux-appimage" href="https://download.letcook.dev/v1.0.40/let-cook-1.0.40-linux-x86_64.AppImage">Linux &middot; AppImage</a>
            </li>
            <li>
              <a data-asset="linux" href="https://download.letcook.dev/v1.0.40/let-cook-1.0.40-linux-x86_64.deb">Ubuntu &middot; .deb</a>
