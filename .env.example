# Cloudflare R2 — release artifacts (CLI + Let Cook).
# GitHub Actions uses COOK_RELEASES_R2_* secrets. Local aliases COOK_S3_* work too.
COOK_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
COOK_S3_ACCESS_KEY=
COOK_S3_SECRET_KEY=
COOK_S3_BUCKET=cook-releases
COOK_S3_REGION=us-east-1
COOK_S3_ADDRESSING_STYLE=path
COOK_RELEASES_PUBLIC_BASE_URL=https://download.letcook.dev
